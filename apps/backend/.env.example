PORT=8080

# Backend API Base URL
API_BASE_URL=http://localhost:8080

# Frontend URL
FRONTEND_URL=https://localhost:3000

# Database
# 格式: postgres://帳號:密碼@localhost:5432/資料庫名稱
# 本地開發使用 Docker 時的連接字串
DATABASE_URL=postgres://myuser:mypassword@127.0.0.1:5432/my_db

# Better Auth
# 使用隨機生成的密鑰，可用以下指令生成：openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-change-this

# Better Auth URL - 必須與實際部署的協議一致
# 本地開發: http://localhost:8080
# 生產環境: https://your-domain.com (使用 HTTPS 時 cookie 會自動添加 __Secure- 前綴)
BETTER_AUTH_URL=http://localhost:8080

# Google OAuth
# 在 Google Cloud Console 建立 OAuth 2.0 憑證後填入
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret