# ========================================
# Zeabur 環境變數設定檔
# ========================================
# 請將以下內容複製到 Zeabur 的 Variables 頁面
# ========================================

# 伺服器端口（Zeabur 會自動處理，但保留此設定）
PORT=8080

# 前端 URL（用於 CORS 和 Better Auth 重導向）
FRONTEND_URL=https://fieldtotable--frontend.pages.dev

# 資料庫連接（使用 Zeabur 的 PostgreSQL 服務）
# 在 Zeabur 上設定為：${POSTGRES_CONNECTION_STRING}
DATABASE_URL=${POSTGRES_CONNECTION_STRING}

# Better Auth 密鑰（已生成，請直接使用）
BETTER_AUTH_SECRET=DAv2Dufw2RwqaUcgH4DuH/lrclncT4zQyViLPFK4cjc=

# Better Auth URL（使用 Zeabur 自動提供的 URL）
# ⚠️ 方法 1：先產生域名後，手動填入完整網址
# BETTER_AUTH_URL=https://你的域名.zeabur.app
# 
# ⚠️ 方法 2：使用 Zeabur 變數（需確認正確語法）
# BETTER_AUTH_URL=${{ZEABUR_URL}}
BETTER_AUTH_URL=https://your-domain.zeabur.app

# Google OAuth 憑證
# 請在 Google Cloud Console 建立 OAuth 2.0 憑證後填入
# 授權重導向 URI 需設定為：${ZEABUR_URL}/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id-here
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret-here
