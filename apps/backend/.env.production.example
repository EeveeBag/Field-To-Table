# ========================================
# 生產環境變數設定範本
# ========================================
# 此檔案為部署到 Zeabur 或其他生產環境時的環境變數範本
# 請將以下內容複製到 Zeabur 的 Variables 頁面，並填入實際值
# ========================================

# 伺服器端口（Zeabur 會自動處理，但保留此設定）
PORT=8080

# Backend API Base URL（生產環境）
API_BASE_URL=https://your-backend-domain.zeabur.app

# 前端 URL（用於 CORS 和 Better Auth 重導向）
# 範例：https://your-frontend.pages.dev 或 https://your-frontend.vercel.app
FRONTEND_URL_PROD=https://your-frontend-domain.pages.dev

# 資料庫連接（使用 Zeabur 的 PostgreSQL 服務）
# 在 Zeabur 上設定為：${POSTGRES_CONNECTION_STRING}
# 這會自動從 Zeabur 提供的 PostgreSQL 服務取得連接字串
DATABASE_URL=${POSTGRES_CONNECTION_STRING}

# Better Auth Secret
# ⚠️ 重要：使用以下指令生成新的密鑰（不要使用此範例值）
# 生成指令：openssl rand -base64 32
BETTER_AUTH_SECRET=your-production-secret-key-change-this

# Better Auth URL（必須與實際部署的域名一致）
# ⚠️ 重要：必須使用 HTTPS 協議（生產環境會自動添加 __Secure- cookie 前綴）
# 方法 1：手動填入完整網址（推薦）
BETTER_AUTH_URL=https://your-backend-domain.zeabur.app
# 方法 2：使用 Zeabur 提供的環境變數（如果支援）
# BETTER_AUTH_URL=${{ZEABUR_URL}}

# Google OAuth 憑證
# 請在 Google Cloud Console 建立 OAuth 2.0 憑證後填入
# 授權重導向 URI 需設定為：https://your-backend-domain.zeabur.app/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
